<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='eurobot_ground'>
    <static>true</static>

    <link name='ground_link'>

      <!-- Colisión para que los robots puedan rodar encima -->
      <collision name='ground_collision'>
        <geometry>
          <box>
            <size>2.0 3.0 0.01</size>
          </box>
        </geometry>
      </collision>

      <visual name='ground_visual'>
        <geometry>
          <box>
            <size>2.0 3.0 0.01</size>
          </box>
        </geometry>

        <material>
          <script>
            <uri>model://eurobot_ground/materials/scripts/</uri>
            <uri>model://eurobot_ground/materials/textures/</uri>
            <name>eurobot_ground/eurobot_material</name>
          </script>
        </material>
      </visual>

      <!-- Centrado en el origen -->
      <pose>0 0 0 0 0 1.5708</pose>

      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>

    </link>
  </model>
</sdf>
