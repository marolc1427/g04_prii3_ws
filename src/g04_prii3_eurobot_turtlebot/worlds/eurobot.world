<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="proyecto">

    <!-- Luz -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Suelo -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ArUco 8 -->
    <include>
      <uri>model://aruco_8</uri>
      <pose>1.4 0.9 0.1 0 0 0</pose>
    </include>

    <!-- Valla -->
    <include>
      <uri>model://valla</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Suelo Eurobot -->
    <include>
      <uri>model://eurobot_ground</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>


    <!-- =============================== -->
    <!--           Overhead Camera       -->
    <!-- =============================== -->

    <model name='overhead_camera'>
      <static>1</static>
      <pose>0 -1 1.5 0 0.964 1.57</pose>

      <link name='overhead_camera_link'>
        <sensor name='camera_sensor' type='camera'>
          <always_on>1</always_on>
          <update_rate>20</update_rate>

          <camera>
            <horizontal_fov>1.75</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>

          <visualize>1</visualize>
          <topic>/overhead_camera/image_raw</topic>

          <plugin name='gazebo_ros_camera' filename='libgazebo_ros_camera.so'>
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <camera_name>overhead_camera</camera_name>
            <image_topic_name>image_raw</image_topic_name>
            <camera_info_topic_name>camera_info</camera_info_topic_name>
            <frame_name>overhead_camera_link</frame_name>
          </plugin>

        </sensor>

        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
    </model>


    <!-- TurtleBot3 Waffle -->
    <include>
      <uri>model://turtlebot3_waffle_aruco_3</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
